# =========================
# NallBid Git Ignore
# =========================

# Environment variables / secrets
.env
.env.*
!.env.example

# Python virtual environment
venv/
.venv/
env/

# Python cache
__pycache__/
*.py[cod]
*$py.class

# Python build files
*.egg-info/
dist/
build/

# Test / coverage cache
.pytest_cache/
.coverage
htmlcov/

# FastAPI / temporary files
*.log
*.tmp

# Node.js
node_modules/
frontend/node_modules/

# Frontend build
frontend/dist/
frontend/build/

# Vite
.vite/

# IDE
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

.idea/

# OS files
.DS_Store
Thumbs.db

# Database/local files
*.db
*.sqlite
*.sqlite3

# Uploaded/generated files
uploads/
generated/